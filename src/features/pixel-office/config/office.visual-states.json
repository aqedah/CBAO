      "clip": "still",
      "color_token": "muted",
      "icon": "plug",
      "work_motion": false
    },
    "unknown": {
      "label": "상태 확인 필요",
      "clip": "still",
      "color_token": "muted",
      "icon": "question",
      "work_motion": false
    },
    "queued": {
      "label": "배정 대기",
      "clip": "waiting",
      "color_token": "muted",
      "icon": "clock",
      "work_motion": false
    },
    "starting": {
      "label": "실행 시작 확인 중",
      "clip": "still",
      "color_token": "muted",
      "icon": "clock",
      "work_motion": false
    },
    "working": {
      "label": "작업 중",
      "clip": "typing",
      "color_token": "active",
      "icon": "keyboard",
      "work_motion": true
    },
    "testing": {
      "label": "검사 중",
      "clip": "typing",
      "color_token": "active",
      "icon": "checklist",
      "work_motion": true
    },
    "reviewing": {
      "label": "검토·자료 확인 중",
      "clip": "reading",
      "color_token": "active",
      "icon": "book",
      "work_motion": true
    },
    "ai_reported": {
      "label": "작업 중 · AI 보고",
      "clip": "still",
      "color_token": "muted",
      "icon": "message",
      "work_motion": false
    },
    "external_work": {
      "label": "외부 작업 · 직접 보고",
