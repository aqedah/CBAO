      "color_token": "attention",
      "icon": "external",
      "work_motion": false
    },
    "external_idle": {
      "label": "외부 서비스 · 상태 미확인",
      "clip": "still",
      "color_token": "muted",
      "icon": "external",
      "work_motion": false
