    "completed": {
      "label": "업무 완료",
      "clip": "still",
      "color_token": "active",
      "icon": "check",
      "work_motion": false
    },
    "cancelled": {
      "label": "취소 확인",
      "clip": "still",
      "color_token": "muted",
      "icon": "stop",
      "work_motion": false
    },
    "idle": {
      "label": "대기",
      "clip": "idle",
      "color_token": "muted",
      "icon": "chair",
      "work_motion": false
    },
    "inconsistent": {
      "label": "상태 불일치 · 새로 확인 필요",
      "clip": "still",
      "color_token": "error",
      "icon": "warning",
      "work_motion": false
    },
    "server_reported": {
      "label": "실행 중 · 서버 기록",
      "clip": "still",
      "color_token": "muted",
      "icon": "server",
      "work_motion": false
    },
    "run_finished": {
      "label": "실행 종료 · 결과 확인 필요",
      "clip": "still",
      "color_token": "attention",
      "icon": "inbox",
      "work_motion": false
    }
  },
  "motion_guard": "work_motion requires fresh runner_observed running evidence; reduced motion/hidden stops all clips",
  "no_implicit_transitions": [
    "run.succeeded -> task.done",
    "external_report.working -> connection.healthy",
    "heartbeat_timeout -> run.failed",
    "avatar_arrived -> handoff.accepted",
    "run.succeeded -> artifact.submitted"
  ]
}
